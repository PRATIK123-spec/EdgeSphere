# Configuration for `docker compose up`. Copy to .env.docker and replace the
# placeholders. Never commit .env.docker. Used by the db and api services.

# PostgreSQL container (first start only; changing them later needs `docker compose down -v`)
POSTGRES_USER=edgesphere
POSTGRES_PASSWORD=change-me
POSTGRES_DB=edgesphere

# Must match the three values above; host "db" is the compose service name.
DATABASE_URL=postgresql+psycopg://edgesphere:change-me@db:5432/edgesphere

# JWT signing secret: `python -c "import secrets; print(secrets.token_urlsafe(48))"`
SECRET_KEY=replace-with-a-long-random-secret

DEBUG=false
SQL_ECHO=false
DEVICE_MONITOR_ENABLED=true
# The browser talks to the Vite proxy, so no CORS origins are needed.
CORS_ORIGINS=
