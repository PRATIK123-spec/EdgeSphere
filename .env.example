# EdgeSphere backend configuration. Copy to .env and fill in real values.
# Never commit .env. All values below are placeholders.

# PostgreSQL connection (SQLAlchemy URL, psycopg 3 driver)
DATABASE_URL=postgresql+psycopg://edgesphere:change-me@localhost:5432/edgesphere

# JWT signing secret: long random string, e.g. `python -c "import secrets; print(secrets.token_urlsafe(48))"`
SECRET_KEY=replace-with-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

DEBUG=false
# Log SQL statements with parameters (development only; never in production)
SQL_ECHO=false

# Device status monitor
DEVICE_OFFLINE_AFTER_SECONDS=60
DEVICE_MONITOR_INTERVAL_SECONDS=15
DEVICE_MONITOR_ENABLED=true

# Minimum seconds between two alerts of the same type for one device
ALERT_COOLDOWN_SECONDS=300

# Browser origins allowed to call the API cross-origin (comma-separated, no "*").
# Leave empty when the frontend is served from the same origin or via the Vite proxy.
CORS_ORIGINS=

# WebSocket: seconds to send the auth message after connecting; heartbeat interval
WS_AUTH_TIMEOUT_SECONDS=10
WS_HEARTBEAT_SECONDS=30
